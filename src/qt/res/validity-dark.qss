/* Validity Dark Theme */
/* Inspired by modern crypto dashboard design */

/* Main window and all widgets */
* {
    background-color: #1a1a2e;
    color: #e0e0e0;
    font-family: "Segoe UI", Arial, sans-serif;
}

QWidget {
    background-color: #1a1a2e;
    color: #e0e0e0;
}

/* Main window specific */
QMainWindow {
    background-color: #0f0f23;
}

/* Force dark on stacked pages */
QStackedWidget, QStackedWidget > QWidget {
    background-color: #1a1a2e;
}

/* Menu bar */
QMenuBar {
    background-color: #16213e;
    color: #e0e0e0;
    border-bottom: 1px solid #2a2a4a;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2a2a4a;
}

/* Dropdown menus */
QMenu {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #00C853;
    color: #0f0f23;
}

QMenu::separator {
    height: 1px;
    background: #2a2a4a;
    margin: 4px 8px;
}

/* Toolbar (tab bar with Overview, Send, Receive, Transactions) */
QToolBar {
    background-color: #16213e;
    border-bottom: 1px solid #2a2a4a;
    spacing: 8px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #8888aa;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

QToolBar QToolButton:hover {
    background-color: #2a2a4a;
    color: #e0e0e0;
}

QToolBar QToolButton:checked {
    background-color: rgba(0, 200, 83, 0.15);
    color: #00C853;
    border-bottom: 2px solid #00C853;
}

/* Scroll areas */
QScrollArea {
    border: none;
    background-color: #1a1a2e;
}

/* Labels */
QLabel {
    color: #e0e0e0;
    background-color: transparent;
}

QLabel[class="header"] {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
}

/* Group boxes (card-like containers) */
QGroupBox {
    background-color: #16213e;
    border: 1px solid #2a2a4a;
    border-radius: 10px;
    margin-top: 12px;
    padding: 16px;
    padding-top: 28px;
    font-weight: bold;
    color: #00C853;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    color: #00C853;
    font-size: 14px;
}

/* Frames (used as card containers) */
QFrame {
    background-color: transparent;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    /* HLine and VLine separators */
    background-color: #2a2a4a;
    border: none;
    max-height: 1px;
}

/* Push buttons */
QPushButton {
    background-color: #00C853;
    color: #0f0f23;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: bold;
    font-size: 13px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #00E676;
}

QPushButton:pressed {
    background-color: #00A844;
}

QPushButton:disabled {
    background-color: #2a2a4a;
    color: #666688;
}

QPushButton#sendButton {
    background-color: #00C853;
    min-width: 120px;
}

QPushButton#clearButton, QPushButton#deleteButton {
    background-color: #2a2a4a;
    color: #e0e0e0;
}

QPushButton#clearButton:hover, QPushButton#deleteButton:hover {
    background-color: #3a3a5a;
}

/* Line edits (text inputs) */
QLineEdit {
    background-color: #0f0f23;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #00C853;
    selection-color: #0f0f23;
}

QLineEdit:focus {
    border: 1px solid #00C853;
}

QLineEdit:disabled {
    background-color: #16213e;
    color: #666688;
}

/* Text edits */
QTextEdit, QPlainTextEdit {
    background-color: #0f0f23;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #00C853;
}

/* Combo boxes (dropdowns) */
QComboBox {
    background-color: #0f0f23;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    padding: 6px 12px;
    min-width: 120px;
}

QComboBox:hover {
    border: 1px solid #00C853;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    selection-background-color: #00C853;
    selection-color: #0f0f23;
}

/* Spin boxes */
QSpinBox, QDoubleSpinBox {
    background-color: #0f0f23;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    padding: 6px;
}

/* Tables (transaction list, address book) */
QTableView, QTreeView, QListView {
    background-color: #16213e;
    alternate-background-color: #1a1f3a;
    color: #e0e0e0;
    border: 1px solid #2a2a4a;
    border-radius: 8px;
    gridline-color: #2a2a4a;
    selection-background-color: rgba(0, 200, 83, 0.2);
    selection-color: #ffffff;
    outline: none;
}

QTableView::item, QTreeView::item, QListView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #1a1a2e;
}

QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: rgba(0, 200, 83, 0.2);
    color: #ffffff;
}

QHeaderView::section {
    background-color: #0f0f23;
    color: #8888aa;
    border: none;
    border-bottom: 2px solid #2a2a4a;
    padding: 8px 12px;
    font-weight: bold;
    font-size: 12px;
    text-transform: uppercase;
}

/* Scroll bars */
QScrollBar:vertical {
    background-color: #16213e;
    width: 8px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #2a2a4a;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3a3a5a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #16213e;
    height: 8px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #2a2a4a;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3a3a5a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Progress bar */
QProgressBar {
    background-color: #0f0f23;
    border: 1px solid #2a2a4a;
    border-radius: 6px;
    text-align: center;
    color: #e0e0e0;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #00C853;
    border-radius: 5px;
}

/* Tab widget */
QTabWidget::pane {
    background-color: #1a1a2e;
    border: 1px solid #2a2a4a;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #16213e;
    color: #8888aa;
    border: none;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #1a1a2e;
    color: #00C853;
    border-bottom: 2px solid #00C853;
}

QTabBar::tab:hover {
    color: #e0e0e0;
}

/* Status bar */
QStatusBar {
    background-color: #0f0f23;
    color: #8888aa;
    border-top: 1px solid #2a2a4a;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #8888aa;
    padding: 0 8px;
}

/* Tooltips */
QToolTip {
    background-color: #16213e;
    color: #e0e0e0;
    border: 1px solid #00C853;
    border-radius: 4px;
    padding: 6px;
}

/* Check boxes and radio buttons */
QCheckBox, QRadioButton {
    color: #e0e0e0;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #2a2a4a;
    border-radius: 3px;
    background-color: #0f0f23;
}

QRadioButton::indicator {
    border-radius: 11px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #00C853;
    border-color: #00C853;
}

/* Dialog boxes */
QDialog {
    background-color: #1a1a2e;
}

/* Splitter */
QSplitter::handle {
    background-color: #2a2a4a;
}

/* ===== OVERVIEW PAGE STYLING ===== */

/* Card-style frames on overview page */
QFrame#frame, QFrame#frame_2, QFrame#frameStakingReport {
    background-color: #16213e;
    border: 1px solid #2a2a4a;
    border-radius: 10px;
    padding: 12px;
    margin: 4px;
}

/* Staking report styling */
QLabel#labelStakingHeader {
    color: #ffffff;
    font-size: 15px;
}

QLabel#labelStaking24hText, QLabel#labelStaking7dText,
QLabel#labelStaking30dText, QLabel#labelStaking1yText {
    color: #8888aa;
    font-size: 13px;
}

QLabel#labelStaking24h, QLabel#labelStaking7d,
QLabel#labelStaking30d, QLabel#labelStaking1y {
    color: #00C853;
    font-size: 13px;
    font-weight: bold;
}

QLabel#labelStakingTotalText {
    color: #e0e0e0;
    font-size: 14px;
}

QLabel#labelStakingTotal {
    color: #00E676;
    font-size: 15px;
    font-weight: bold;
}

/* Balance amounts - green and prominent */
QLabel#labelBalance, QLabel#labelTotal, QLabel#labelWatchAvailable,
QLabel#labelWatchTotal, QLabel#labelStake {
    color: #00C853;
    font-size: 16px;
    font-weight: bold;
}

QLabel#labelTotal {
    font-size: 18px;
    color: #00E676;
}

/* Pending/unconfirmed - muted */
QLabel#labelUnconfirmed, QLabel#labelWatchPending {
    color: #8888aa;
    font-size: 14px;
}

/* Balance labels */
QLabel#labelAvailableText, QLabel#labelPendingText, QLabel#labelTotalText,
QLabel#labelStakeText, QLabel#labelWatchonly, QLabel#labelSpendable {
    color: #8888aa;
    font-size: 13px;
}

/* Section headers bold white */
QLabel#label_5, QLabel#label_4 {
    color: #ffffff;
    font-size: 15px;
}

/* Warning status buttons - hide during sync, status bar shows progress */
QPushButton#labelWalletStatus, QPushButton#labelTransactionsStatus {
    background-color: transparent;
    border: none;
    max-width: 0px;
    max-height: 0px;
    padding: 0px;
    margin: 0px;
}

/* Recent transactions list widget */
QListView#listTransactions {
    background-color: #16213e;
    border: 1px solid #2a2a4a;
    border-radius: 8px;
    padding: 4px;
}

/* ===== SEND PAGE ===== */
QLabel#labelCoinControlFeatures {
    color: #00C853;
    font-weight: bold;
}

/* ===== STATUS BAR ===== */
QStatusBar {
    background-color: #0f0f23;
    color: #8888aa;
    border-top: 1px solid #2a2a4a;
    min-height: 24px;
}

QStatusBar QLabel {
    color: #8888aa;
    padding: 0 8px;
}

QStatusBar QProgressBar {
    min-width: 150px;
    max-height: 14px;
}
