/* Validity Dark Theme — v2 refined */

/* Color palette:
   bg-deep:    #0f0f1a    (deepest background)
   bg-main:    #171728    (main content)
   bg-card:    #1e1e36    (card/panel surfaces)
   bg-input:   #12121f    (input fields)
   border:     #2d2d4a    (subtle borders)
   border-hl:  #3d3d5a    (hover borders)
   text-pri:   #c8c8d8    (primary text — warm gray, not pure white)
   text-sec:   #7a7a96    (secondary/label text)
   text-dim:   #55556e    (disabled/hint text)
   accent:     #4ecca3    (primary accent — muted teal-green)
   accent-hl:  #6be4b8    (hover accent)
   accent-dim: #3aad87    (pressed accent)
   positive:   #4ecca3    (positive amounts)
   negative:   #e85d75    (negative amounts)
   warning:    #e8a84e    (warnings)
*/

/* === GLOBAL === */
* {
    background-color: #171728;
    color: #c8c8d8;
    font-family: "Segoe UI", Arial, sans-serif;
}

QWidget {
    background-color: #171728;
    color: #c8c8d8;
}

QMainWindow {
    background-color: #0f0f1a;
}

QStackedWidget, QStackedWidget > QWidget {
    background-color: #171728;
}

/* === MENU BAR === */
QMenuBar {
    background-color: #1e1e36;
    color: #c8c8d8;
    border-bottom: 1px solid #2d2d4a;
    padding: 2px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 14px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #2d2d4a;
}

/* === DROPDOWN MENUS === */
QMenu {
    background-color: #1e1e36;
    color: #c8c8d8;
    border: 1px solid #2d2d4a;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #4ecca3;
    color: #0f0f1a;
}

QMenu::separator {
    height: 1px;
    background: #2d2d4a;
    margin: 4px 10px;
}

/* === TOOLBAR (Overview, Send, Receive, Transactions) === */
QToolBar {
    background-color: #1e1e36;
    border-bottom: 1px solid #2d2d4a;
    spacing: 6px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #7a7a96;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

QToolBar QToolButton:hover {
    background-color: #2d2d4a;
    color: #c8c8d8;
}

QToolBar QToolButton:checked {
    background-color: rgba(78, 204, 163, 0.12);
    color: #4ecca3;
    border-bottom: 2px solid #4ecca3;
}

/* === SCROLL AREAS === */
QScrollArea {
    border: none;
    background-color: #171728;
}

/* === LABELS === */
QLabel {
    color: #c8c8d8;
    background-color: transparent;
}

/* === GROUP BOXES === */
QGroupBox {
    background-color: #1e1e36;
    border: 1px solid #2d2d4a;
    border-radius: 8px;
    margin-top: 12px;
    padding: 14px;
    padding-top: 26px;
    font-weight: bold;
    color: #4ecca3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    color: #4ecca3;
    font-size: 13px;
}

/* === FRAMES === */
QFrame {
    background-color: transparent;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    background-color: #2d2d4a;
    border: none;
    max-height: 1px;
}

/* === BUTTONS === */
QPushButton {
    background-color: #2d3b52;
    color: #c8c8d8;
    border: 1px solid #3d4d64;
    border-radius: 6px;
    padding: 7px 18px;
    font-weight: 600;
    font-size: 12px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #3a4d66;
    border-color: #4ecca3;
    color: #e0e0e8;
}

QPushButton:pressed {
    background-color: #243344;
}

QPushButton:disabled {
    background-color: #1e1e36;
    color: #55556e;
    border-color: #2d2d4a;
}

/* Primary action buttons */
QPushButton#sendButton, QPushButton#receiveButton, QPushButton#requestPaymentButton {
    background-color: #2a6b56;
    color: #c8e8d8;
    border: 1px solid #3a8b6e;
}

QPushButton#sendButton:hover, QPushButton#receiveButton:hover, QPushButton#requestPaymentButton:hover {
    background-color: #348868;
    border-color: #4ecca3;
    color: #e0f0e8;
}

/* Secondary buttons */
QPushButton#clearButton, QPushButton#deleteButton, QPushButton#addButton {
    background-color: #2d2d4a;
    color: #c8c8d8;
    border: 1px solid #3d3d5a;
}

QPushButton#clearButton:hover, QPushButton#deleteButton:hover, QPushButton#addButton:hover {
    background-color: #3d3d5a;
}

/* === INPUT FIELDS === */
QLineEdit {
    background-color: #12121f;
    color: #c8c8d8;
    border: 1px solid #2d2d4a;
    border-radius: 5px;
    padding: 7px 10px;
    font-size: 12px;
    selection-background-color: #4ecca3;
    selection-color: #0f0f1a;
}

QLineEdit:focus {
    border: 1px solid #4ecca3;
}

QLineEdit:disabled {
    background-color: #1e1e36;
    color: #55556e;
}

QTextEdit, QPlainTextEdit {
    background-color: #12121f;
    color: #c8c8d8;
    border: 1px solid #2d2d4a;
    border-radius: 5px;
    padding: 6px;
    selection-background-color: #4ecca3;
}

/* === COMBO BOXES === */
QComboBox {
    background-color: #12121f;
    color: #c8c8d8;
    border: 1px solid #2d2d4a;
    border-radius: 5px;
    padding: 6px 10px;
    min-width: 100px;
}

QComboBox:hover {
    border: 1px solid #4ecca3;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #1e1e36;
    color: #c8c8d8;
    border: 1px solid #2d2d4a;
    selection-background-color: #4ecca3;
    selection-color: #0f0f1a;
}

/* === SPIN BOXES === */
QSpinBox, QDoubleSpinBox {
    background-color: #12121f;
    color: #c8c8d8;
    border: 1px solid #2d2d4a;
    border-radius: 5px;
    padding: 5px;
}

/* === TABLES & LISTS === */
QTableView, QTreeView, QListView {
    background-color: #1e1e36;
    alternate-background-color: #1a1a30;
    color: #c8c8d8;
    border: 1px solid #2d2d4a;
    border-radius: 6px;
    gridline-color: #2d2d4a;
    selection-background-color: rgba(78, 204, 163, 0.15);
    selection-color: #e0e0e8;
    outline: none;
}

QTableView::item, QTreeView::item, QListView::item {
    padding: 5px 8px;
    border-bottom: 1px solid #1a1a2a;
}

QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: rgba(78, 204, 163, 0.15);
    color: #e0e0e8;
}

QHeaderView::section {
    background-color: #12121f;
    color: #7a7a96;
    border: none;
    border-bottom: 1px solid #2d2d4a;
    padding: 7px 10px;
    font-weight: bold;
    font-size: 11px;
}

/* === SCROLLBARS === */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #2d2d4a;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3d3d5a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 6px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #2d2d4a;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3d3d5a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === PROGRESS BAR === */
QProgressBar {
    background-color: #12121f;
    border: 1px solid #2d2d4a;
    border-radius: 4px;
    text-align: center;
    color: #c8c8d8;
    min-height: 14px;
}

QProgressBar::chunk {
    background-color: #4ecca3;
    border-radius: 3px;
}

/* === TAB WIDGET (Debug window etc) === */
QTabWidget::pane {
    background-color: #171728;
    border: 1px solid #2d2d4a;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #1e1e36;
    color: #7a7a96;
    border: none;
    padding: 9px 18px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:selected {
    background-color: #171728;
    color: #4ecca3;
    border-bottom: 2px solid #4ecca3;
}

QTabBar::tab:hover {
    color: #c8c8d8;
}

/* === STATUS BAR === */
QStatusBar {
    background-color: #0f0f1a;
    color: #7a7a96;
    border-top: 1px solid #2d2d4a;
    padding: 3px;
    min-height: 22px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #7a7a96;
    padding: 0 6px;
}

QStatusBar QProgressBar {
    min-width: 140px;
    max-height: 12px;
}

/* === TOOLTIPS === */
QToolTip {
    background-color: #1e1e36;
    color: #c8c8d8;
    border: 1px solid #4ecca3;
    border-radius: 4px;
    padding: 5px;
}

/* === CHECKBOXES & RADIO BUTTONS === */
QCheckBox, QRadioButton {
    color: #c8c8d8;
    spacing: 7px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3d3d5a;
    border-radius: 3px;
    background-color: #12121f;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #4ecca3;
    border-color: #4ecca3;
}

/* === DIALOGS === */
QDialog {
    background-color: #171728;
}

QSplitter::handle {
    background-color: #2d2d4a;
}

/* ============================================= */
/* ===== OVERVIEW PAGE                     ===== */
/* ============================================= */

/* Card surfaces */
QFrame#frame, QFrame#frame_2, QFrame#frameStakingReport {
    background-color: #1e1e36;
    border: 1px solid #2d2d4a;
    border-radius: 8px;
    padding: 10px;
    margin: 3px;
}

/* Section headers */
QLabel#label_5, QLabel#label_4 {
    color: #c8c8d8;
    font-size: 14px;
    font-weight: bold;
}

/* Balance amounts */
QLabel#labelBalance, QLabel#labelWatchAvailable, QLabel#labelStake {
    color: #4ecca3;
    font-size: 15px;
    font-weight: bold;
}

QLabel#labelTotal, QLabel#labelWatchTotal {
    color: #6be4b8;
    font-size: 17px;
    font-weight: bold;
}

QLabel#labelUnconfirmed, QLabel#labelWatchPending {
    color: #7a7a96;
    font-size: 13px;
}

/* Balance labels */
QLabel#labelAvailableText, QLabel#labelPendingText, QLabel#labelTotalText,
QLabel#labelStakeText, QLabel#labelWatchonly, QLabel#labelSpendable {
    color: #7a7a96;
    font-size: 12px;
}

/* Staking report */
QLabel#labelStakingHeader {
    color: #c8c8d8;
    font-size: 14px;
    font-weight: bold;
}

QLabel#labelStaking24hText, QLabel#labelStaking7dText,
QLabel#labelStaking30dText, QLabel#labelStaking1yText {
    color: #7a7a96;
    font-size: 12px;
}

QLabel#labelStaking24h, QLabel#labelStaking7d,
QLabel#labelStaking30d, QLabel#labelStaking1y {
    color: #4ecca3;
    font-size: 12px;
    font-weight: bold;
}

QLabel#labelStakingTotalText {
    color: #c8c8d8;
    font-size: 13px;
}

QLabel#labelStakingTotal {
    color: #6be4b8;
    font-size: 14px;
    font-weight: bold;
}

/* Hide sync warning icons */
QPushButton#labelWalletStatus, QPushButton#labelTransactionsStatus {
    background-color: transparent;
    border: none;
    max-width: 0px;
    max-height: 0px;
    padding: 0px;
    margin: 0px;
}

/* Recent transactions list */
QListView#listTransactions {
    background-color: #1e1e36;
    border: 1px solid #2d2d4a;
    border-radius: 6px;
    padding: 3px;
}

/* ============================================= */
/* ===== SEND PAGE                         ===== */
/* ============================================= */
QLabel#labelCoinControlFeatures {
    color: #4ecca3;
    font-weight: bold;
    font-size: 13px;
}
